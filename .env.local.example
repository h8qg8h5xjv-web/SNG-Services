# Supabase — copy to .env.local and fill in. Never commit .env.local.
# Project URL and anon key are safe for the browser (NEXT_PUBLIC_*).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only secret. Bypasses RLS — never expose to the client, never prefix NEXT_PUBLIC.
# Used by the seed script and privileged server writes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL of the site, used for absolute links (metadata, hreflang, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
